# Copy to .env.prod and fill in. The values below suit a local demo over http.
# On a server, use https URLs and set INSECURE_COOKIES=false.

# Public URLs (what a browser uses)
BACKEND_URL=http://localhost:9000
STOREFRONT_URL_ALBRECHT=http://localhost:8001
STOREFRONT_URL_NORDKANT=http://localhost:8002
STOREFRONT_URL_FESTWERK=http://localhost:8003
STOREFRONT_URL_KONTOR9=http://localhost:8004

# Secrets. Generate each one with:  openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
COOKIE_SECRET=

# Admin login created on first start
ADMIN_EMAIL=
ADMIN_PASSWORD=

# true only when served over plain http (local demo). Never on a public server.
INSECURE_COOKIES=true

# Demo catalogue with 4 brands. Set to false for an empty shop.
SEED_DEMO_BRANDS=true

# Default country of the storefronts (must be part of a region)
DEFAULT_REGION=de
