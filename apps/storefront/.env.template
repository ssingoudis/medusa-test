# Copy to .env.local for local development.

# Publishable API key of the brand (sales channel) this storefront serves.
# Admin: Settings > Publishable API Keys, or run the export script (SETUP.md).
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# URL of the Medusa backend
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Default country of the storefront (must be part of a region)
NEXT_PUBLIC_DEFAULT_REGION=de

# Base URL of the storefront
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Shop branding
NEXT_PUBLIC_STORE_NAME=Albrecht & Söhne
NEXT_PUBLIC_STORE_TAGLINE=Klassische Herrenanzüge im Premiumsegment

# Stripe publishable key (optional)
NEXT_PUBLIC_STRIPE_KEY=
